# Spotify App Remote SDK 0.8.0 ships optional Jackson mappers. Retrofy uses
# the SDK's default Gson mapper, so Jackson is not bundled; these references
# are never reached. (Generated by R8 as missing_rules.txt.)
-dontwarn com.fasterxml.jackson.databind.deser.std.StdDeserializer
-dontwarn com.fasterxml.jackson.databind.ser.std.StdSerializer
-dontwarn com.spotify.base.annotations.NotNull

# App Remote finds the Spotify app by reflection: SpotifyLocator calls
# Class.forName("...ReleaseSpotifyLocator").getConstructor().newInstance().
# The SDK's own rule keeps only the class names; R8 full mode then removes the
# unreferenced constructors, isSpotifyInstalled() returns false and playback
# reports "Install the Spotify app". Keep the constructors and members.
-keep class com.spotify.android.appremote.internal.ReleaseSpotifyLocator {
    public <init>();
    *;
}
-keep class com.spotify.android.appremote.internal.DebugSpotifyLocator {
    public <init>();
    *;
}
-keep interface com.spotify.android.appremote.internal.PackageProvider { *; }
